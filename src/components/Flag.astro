---
// Small round flag for the language switch. Flag colours are the flags' own, not brand tokens.
interface Props { lang: 'en' | 'id'; class?: string }
const { lang, class: cls = 'size-5' } = Astro.props;
---
<svg viewBox="0 0 24 24" class:list={['shrink-0 rounded-full', cls]} aria-hidden="true">
  {lang === 'id' ? (
    <>
      <rect width="24" height="12" fill="#CE1126" />
      <rect y="12" width="24" height="12" fill="#FFFFFF" />
    </>
  ) : (
    <>
      <rect width="24" height="24" fill="#012169" />
      <path d="M0 0L24 24M24 0L0 24" stroke="#FFFFFF" stroke-width="4.5" />
      <path d="M0 0L24 24M24 0L0 24" stroke="#C8102E" stroke-width="1.6" />
      <path d="M12 0V24M0 12H24" stroke="#FFFFFF" stroke-width="7" />
      <path d="M12 0V24M0 12H24" stroke="#C8102E" stroke-width="4" />
    </>
  )}
</svg>
