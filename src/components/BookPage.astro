---
import Base from '@/layouts/Base.astro';
import { getCopy, bookPath, cal, contactHref, site, type Lang } from '@/config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getCopy(lang);
const b = t.book;
const alternates = { en: bookPath('en'), id: bookPath('id') };
---
<Base lang={lang} title={b.metaTitle} description={b.metaDescription} alternates={alternates}>
  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">{b.eyebrow}</p>
        <h1 class="h1 mt-4 sm:text-6xl!">{b.h1}</h1>
        <p class="lead mt-5">{b.lead}</p>

        <h2 class="mt-10 text-xl">{b.coverTitle}</h2>
        <ul class="mt-4 space-y-3">
          {b.cover.map((x) => (
            <li class="flex gap-3 text-ink-muted">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
              <span>{x}</span>
            </li>
          ))}
        </ul>

        <h2 class="mt-10 text-xl">{b.bringTitle}</h2>
        <p class="mt-3 text-ink-muted">{b.bring}</p>

        <p class="mt-10 border-l-2 border-brand-500 pl-4 font-display text-lg">{b.note}</p>
        <p class="mt-6 text-sm text-ink-muted">
          {b.emailPrefix} <a href={contactHref} class="font-semibold text-ink underline underline-offset-4 hover:text-brand-600">{site.email}</a>
        </p>
      </div>

      <div class="lg:col-span-7">
        <h2 class="sr-only">{b.calTitle}</h2>
        <div class="min-h-[40rem] overflow-hidden rounded-3xl border border-line bg-surface shadow-(--shadow-card)">
          <div id="cal-embed" class="min-h-[40rem] w-full" data-cal-link={cal.link} data-cal-ns={cal.namespace} data-cal-origin={cal.origin}>
            <p class="p-6 text-ink-muted">{b.loading}</p>
          </div>
        </div>
        <p class="mt-3 text-sm text-ink-muted">
          {b.fallback} <a href={cal.url} target="_blank" rel="noopener" class="font-semibold text-ink underline underline-offset-4 hover:text-brand-600">{b.openCal}</a>
        </p>
        <noscript>
          <p class="mt-3 text-ink-muted"><a href={cal.url} class="font-semibold underline">{b.openCal}</a></p>
        </noscript>
      </div>
    </div>
  </section>
</Base>

<script>
  // Cal.com inline embed (third-party, loaded only on this page and only when the browser is idle).
  const host = document.getElementById('cal-embed');
  if (host) {
    const { calLink, calNs, calOrigin } = host.dataset as { calLink: string; calNs: string; calOrigin: string };
    const load = () => {
      /* eslint-disable */
      (function (C: any, A: string, L: string) {
        const p = function (a: any, ar: any) { a.q.push(ar); };
        const d = C.document;
        C.Cal = C.Cal || function () {
          const cal = C.Cal; const ar = arguments as any;
          if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; }
          if (ar[0] === L) {
            const api: any = function () { p(api, arguments); };
            const namespace = ar[1]; api.q = api.q || [];
            if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]); } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window, calOrigin + '/embed/embed.js', 'init');
      const Cal = (window as any).Cal;
      Cal('init', calNs, { origin: calOrigin });
      Cal.config = Cal.config || {};
      Cal.config.forwardQueryParams = true;
      host.textContent = '';
      Cal.ns[calNs]('inline', {
        elementOrSelector: '#cal-embed',
        config: { layout: 'month_view', useSlotsViewOnSmallScreen: 'true', theme: 'light' },
        calLink,
      });
      // Logo blue (brand-500). Cal.com needs a plain hex here.
      Cal.ns[calNs]('ui', { theme: 'light', cssVarsPerTheme: { light: { 'cal-brand': '#416EB4' }, dark: { 'cal-brand': '#416EB4' } }, hideEventTypeDetails: false, layout: 'month_view' });
    };
    const idle = (window as any).requestIdleCallback as undefined | ((cb: () => void) => void);
    if (idle) idle(load); else setTimeout(load, 300);
  }
</script>
