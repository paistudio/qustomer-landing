---
import Base from '@/layouts/Base.astro';
import CTA from '@/components/sections/CTA.astro';
import { getCopy, pathFor, type Lang } from '@/config/site';
import { getPages, getPagesUi, pagePath } from '@/config/pages';
import type { PageCopy } from '@/i18n/pages-en';

interface Props { lang: Lang; page: PageCopy }
const { lang, page } = Astro.props;
const t = getCopy(lang);
const ui = getPagesUi(lang);
const langs: Lang[] = ['en', 'id'];
const alternates = Object.fromEntries(langs.map((l) => [l, pagePath(l, page.key)])) as Record<Lang, string>;
const related = getPages(lang).filter((p) => p.kind !== 'legal' && p.key !== page.key).slice(0, 3);
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;

const ld: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: abs(pathFor(lang)) },
      { '@type': 'ListItem', position: 2, name: page.label, item: abs(pagePath(lang, page.key)) },
    ],
  },
];
if (page.faq?.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
const isLegal = page.kind === 'legal';
---
<Base lang={lang} title={page.metaTitle} description={page.description} jsonLd={ld} alternates={alternates} noindex={page.noindex} type={page.kind === 'guide' ? 'article' : 'website'}>
  <article class="section">
    <div class="container-page">
      <nav aria-label={ui.breadcrumb} class="text-sm text-ink-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={pathFor(lang)} class="hover:text-ink">{ui.home}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{page.label}</li>
        </ol>
      </nav>

      <header class="mt-8 max-w-3xl">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1 class="h1 mt-3 sm:text-5xl">{page.h1}</h1>
        <p class="mt-6 text-xl text-ink-muted text-pretty">{page.lead}</p>
        {page.updated && <p class="mt-4 text-sm text-ink-muted">{ui.updated}: <time datetime={page.updated}>{page.updated}</time></p>}
      </header>

      <div class:list={['mt-14 max-w-3xl space-y-14', isLegal && 'space-y-10']}>
        {page.sections.map((s) => (
          <section>
            <h2 class:list={['font-bold tracking-tight text-balance', isLegal ? 'text-xl' : 'text-2xl sm:text-3xl']}>{s.h2}</h2>
            {s.paras?.map((p) => <p class="mt-4 text-lg leading-relaxed text-ink-muted text-pretty">{p}</p>)}
            {s.items && (
              <ul class="mt-6 divide-y divide-line border-y border-line">
                {s.items.map((it) => (
                  <li class="grid gap-1 py-4 sm:grid-cols-[14rem_1fr] sm:gap-x-6">
                    <h3 class="font-semibold">{it.t}</h3>
                    <p class="text-ink-muted">{it.d}</p>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>

      {page.faq && (
        <section class="mt-16 max-w-3xl" aria-labelledby="page-faq">
          <h2 id="page-faq" class="text-2xl font-bold tracking-tight sm:text-3xl">{ui.faq}</h2>
          <div class="mt-6 divide-y divide-line border-y border-line">
            {page.faq.map((f) => (
              <div class="py-5">
                <h3 class="font-semibold">{f.q}</h3>
                <p class="mt-2 text-ink-muted">{f.a}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {!isLegal && related.length > 0 && (
        <section class="mt-16 border-t border-line pt-10" aria-labelledby="related">
          <h2 id="related" class="text-sm font-semibold text-ink-muted">{ui.related}</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-3">
            {related.map((r) => (
              <li><a href={pagePath(lang, r.key)} class="block rounded-2xl bg-surface-alt p-5 font-semibold hover:text-brand-600">{r.label}</a></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
  <CTA slot="cta" t={t} />
</Base>
