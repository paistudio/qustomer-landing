---
import type { Copy } from '@/i18n/en';

interface Props { t: Copy }
const { t } = Astro.props;
const a = t.assistant;
const ask = t.channels.anchor; // the traveler keeps the customer's message here; the reply pops up beside it
---
<section id="assistant" class="section" aria-labelledby="assistant-title">
  <div class="container-page grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2 id="assistant-title" class="h2 max-w-xl">{a.h2}</h2>
      <ol class="mt-12 divide-y divide-line border-y border-line">
        {a.items.map((item, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-2 py-5">
            <span class="text-sm font-semibold text-brand-600 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <p><span class="font-semibold">{item.t}.</span> <span class="text-ink-muted">{item.d}</span></p>
          </li>
        ))}
      </ol>
      <p class="mt-10 max-w-xl border-l-2 border-brand-500 pl-4 text-ink-muted">{a.note}</p>
    </div>

    <!-- Lane (right): the traveler bubble is the assistant's instant reply. -->
    <div data-play class="relative mx-auto aspect-square w-full max-w-md lg:col-span-5" aria-hidden="true">
      <div class="absolute inset-0 rounded-3xl bg-mint-100"></div>
      <div
        data-bubble-anchor
        data-hold
        data-scale="1"
        data-tag={ask.tag}
        data-msg={ask.msg}
        class="absolute top-[32%] left-1/2 size-40 -translate-x-1/2 -translate-y-1/2"
      ></div>
      <!-- Reply: the 3D scene pops a mint bubble at [data-reply-anchor]; this flat copy shows only when the scene is off. -->
      <div class="pop absolute right-6 bottom-20 max-w-[78%] rounded-3xl rounded-br-md bg-mint-300 px-5 py-3 shadow-(--shadow-card) in-data-[scene=on]:invisible" style="--i:2">
        <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">{a.anchor.tag}</p>
        <p class="mt-0.5 font-semibold">{a.anchor.msg}</p>
      </div>
      <div
        data-reply-anchor
        data-scale="1"
        data-tag={a.anchor.tag}
        data-msg={a.anchor.msg}
        class="absolute top-[73%] left-[56%] size-8 -translate-x-1/2 -translate-y-1/2"
      ></div>
      <p class="absolute bottom-4 left-1/2 -translate-x-1/2 text-xs font-semibold text-ink-muted">{a.laneCaption}</p>
    </div>
  </div>
</section>
