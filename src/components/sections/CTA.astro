---
import type { Copy } from '@/i18n/en';
import { bookPath } from '@/config/site';

interface Props { t: Copy }
const { t } = Astro.props;
const c = t.finalCta;
---
<section id="contact" class="border-b border-white/25 px-6 py-14 sm:px-14 sm:py-20" aria-labelledby="cta-title">
  <h2 id="cta-title" class="h2 max-w-2xl sm:text-5xl">{c.h2}</h2>
  <p class="mt-5 max-w-xl text-lg text-brand-50">{c.p}</p>
  <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
    <a href={bookPath(t.lang)} class="btn bg-white text-brand-700 hover:bg-brand-50">{c.button}</a>
    <p class="text-brand-50">{c.note}</p>
  </div>
</section>
