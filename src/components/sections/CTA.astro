---
import { site } from '@/config/site';
---
<section id="get-started" class="section" aria-labelledby="cta-title">
  <div class="container-page">
    <div class="rounded-3xl bg-brand-600 px-6 py-16 text-center text-white sm:px-16">
      <h2 id="cta-title" class="h2">Ready to answer customers faster?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-brand-100">Join teams who cut first-response time in half.</p>
      <a href={site.cta.href} class="btn mt-8 bg-white text-brand-700 hover:bg-brand-50">{site.cta.label}</a>
    </div>
  </div>
</section>
