---
const steps = [
  { title: 'Connect channels', body: 'Plug in email, web chat and WhatsApp in minutes.' },
  { title: 'Invite your team', body: 'Set roles, routing rules and working hours.' },
  { title: 'Answer faster', body: 'Reply from one inbox with saved replies and AI drafts.' },
];
---
<section id="how" class="section" aria-labelledby="how-title">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">How it works</p>
      <h2 id="how-title" class="h2 mt-3">Live in three steps</h2>
    </div>
    <ol class="mt-12 grid gap-8 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="text-center md:text-left">
          <span class="inline-flex size-10 items-center justify-center rounded-full bg-brand-600 font-bold text-white">{i + 1}</span>
          <h3 class="mt-4 text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-ink-muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
