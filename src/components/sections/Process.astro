---
import type { Copy } from '@/i18n/en';

interface Props { t: Copy }
const { t } = Astro.props;
const p = t.process;
---
<section id="process" class="section" aria-labelledby="process-title">
  <div class="container-page">
    <div class="max-w-3xl">
      <p class="eyebrow">{p.eyebrow}</p>
      <h2 id="process-title" class="h2 mt-3 sm:text-5xl">{p.h2}</h2>
      <p class="mt-5 max-w-2xl text-lg text-ink-muted text-pretty">{p.lead}</p>
    </div>

    <ol class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {p.steps.map((s, i) => (
        <li class="border-t-2 border-brand-500 pt-5">
          <span class="text-sm font-semibold text-brand-600 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 text-xl font-semibold tracking-tight">{s.t}</h3>
          <p class="mt-2 text-ink-muted">{s.d}</p>
        </li>
      ))}
    </ol>

    <div class="mt-16 border-t border-line pt-10">
      <h3 class="text-sm font-semibold text-ink-muted">{p.tailorTitle}</h3>
      <ul class="mt-5 flex flex-wrap gap-3">
        {p.tailor.map((x) => (
          <li class="rounded-full bg-mint-100 px-4 py-2 text-sm font-semibold">{x}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
