---
import type { Copy } from '@/i18n/en';

interface Props { t: Copy }
const { t } = Astro.props;
const f = t.faq;
---
<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container-page grid gap-10 lg:grid-cols-12">
    <h2 id="faq-title" class="h2 lg:col-span-4">{f.h2}</h2>
    <div class="divide-y divide-line border-y border-line lg:col-span-8">
      {f.items.map((it) => (
        <details class="group py-5">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
            {it.q}
            <span class="text-2xl leading-none text-brand-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 max-w-2xl text-ink-muted">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
