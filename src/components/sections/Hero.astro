---
import type { Copy } from '@/i18n/en';
import { bookPath } from '@/config/site';

interface Props { t: Copy }
const { t } = Astro.props;
const h = t.hero;
---
<section id="top" class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="container-page grid min-h-[calc(100svh-5rem)] items-center gap-6 py-12 lg:grid-cols-12 lg:py-16">
    <div class="lg:col-span-7">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 id="hero-title" class="h1 mt-4 text-4xl! leading-[1.05] sm:text-6xl! lg:text-7xl!">{h.h1}</h1>
      <p class="lead mt-6 max-w-xl">{h.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={bookPath(t.lang)} class="btn-primary">{h.primary}</a>
        <a href="#process" class="btn-ghost">{h.secondary}</a>
      </div>
      <ul class="mt-10 flex flex-wrap items-baseline gap-x-5 gap-y-1 text-base font-semibold text-ink-muted">
        {h.differ.map((d, i) => i === h.differ.length - 1 ? (
          <li class="relative text-brand-600">
            <span>{d}</span>
            <!-- Hand-drawn underline: draws itself once on load (static when motion is reduced). -->
            <svg class="absolute -bottom-2.5 left-0 h-2.5 w-full" viewBox="0 0 200 12" preserveAspectRatio="none" fill="none" aria-hidden="true">
              <path class="underline-draw" d="M3 8 C 38 3, 66 11, 102 6 S 168 3, 197 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" pathLength="1" vector-effect="non-scaling-stroke" />
            </svg>
          </li>
        ) : <li>{d}</li>)}
      </ul>
    </div>

    <!-- Lane: the 3D traveler bubble starts here. Static bubbles show until (or unless) the 3D scene loads. -->
    <div class="relative min-h-72 lg:col-span-5 lg:min-h-[28rem]" aria-hidden="true">
      <div
        data-bubble-anchor
        data-hold
        data-scale="1"
        data-tag={h.anchor.tag}
        data-msg={h.anchor.msg}
        class="absolute top-1/2 left-1/2 size-8 -translate-x-1/2 -translate-y-1/2"
      ></div>
      <ul class="absolute inset-0 transition-opacity duration-500 in-data-[scene=on]:opacity-0">
        <li class="absolute top-[12%] left-[8%] max-w-56 -rotate-3 rounded-3xl rounded-bl-md bg-brand-500 px-4 py-3 text-sm font-semibold text-white shadow-(--shadow-card)">{h.cloud[1]?.msg}</li>
        <li class="absolute top-[42%] right-[4%] max-w-56 rotate-2 rounded-3xl rounded-br-md bg-mint-300 px-4 py-3 text-sm font-semibold text-ink shadow-(--shadow-card)">{h.cloud[0]?.msg}</li>
        <li class="absolute bottom-[10%] left-[16%] max-w-56 -rotate-1 rounded-3xl rounded-bl-md border border-line bg-surface px-4 py-3 text-sm font-semibold text-ink shadow-(--shadow-card)">{h.cloud[5]?.msg}</li>
      </ul>
    </div>
  </div>
</section>
