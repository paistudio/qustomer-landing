---
const features = [
  { title: 'Unified inbox', body: 'Chat, email and WhatsApp in one queue. No more tab switching.', icon: 'M4 6h16M4 12h16M4 18h10' },
  { title: 'Smart routing', body: 'Send every conversation to the right agent automatically.', icon: 'M5 12h14M13 6l6 6-6 6' },
  { title: 'Real-time analytics', body: 'Track response time and CSAT live, per team and channel.', icon: 'M4 20V10M10 20V4M16 20v-7M22 20H2' },
];
---
<section id="features" class="section bg-surface-alt" aria-labelledby="features-title">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Features</p>
      <h2 id="features-title" class="h2 mt-3">Everything your support team needs</h2>
    </div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <li class="card">
          <svg aria-hidden="true" class="size-10 rounded-lg bg-brand-50 p-2 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={f.icon} /></svg>
          <h3 class="mt-4 text-lg font-semibold">{f.title}</h3>
          <p class="mt-2 text-ink-muted">{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
