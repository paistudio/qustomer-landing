---
import type { Copy } from '@/i18n/en';

interface Props { t: Copy }
const { t } = Astro.props;
const c = t.channels;
const r = c.record;
// Pill positions around the lane centre (percent). Order matches c.pills.
const spots = ['top-[6%] left-[4%]', 'top-[6%] right-[4%]', 'bottom-[14%] left-[4%]', 'bottom-[14%] right-[4%]'];
---
<section id="channels" class="section bg-surface-alt" aria-labelledby="channels-title">
  <div class="container-page grid items-center gap-12 lg:grid-cols-12">
    <!-- Lane (left): four channels converge on one point; the traveler bubble lands in the middle. -->
    <div class="relative mx-auto aspect-square w-full max-w-md lg:col-span-5" aria-hidden="true">
      <svg viewBox="0 0 100 100" class="absolute inset-0 size-full text-brand-500" fill="none">
        <path d="M20 14 C 30 34, 44 42, 50 50" stroke="currentColor" stroke-width="1.5" stroke-dasharray="1.5 3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        <path d="M80 14 C 70 34, 56 42, 50 50" stroke="currentColor" stroke-width="1.5" stroke-dasharray="1.5 3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        <path d="M20 80 C 30 66, 44 58, 50 50" stroke="currentColor" stroke-width="1.5" stroke-dasharray="1.5 3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        <path d="M80 80 C 70 66, 56 58, 50 50" stroke="currentColor" stroke-width="1.5" stroke-dasharray="1.5 3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
      </svg>
      {c.pills.map((p, i) => (
        <span class:list={['absolute rounded-full border border-line bg-surface px-4 py-2 text-sm font-semibold shadow-(--shadow-card)', spots[i]]}>{p}</span>
      ))}
      <div
        data-bubble-anchor
        data-hold
        data-scale="0.95"
        data-tag={c.anchor.tag}
        data-msg={c.anchor.msg}
        class="absolute top-1/2 left-1/2 size-40 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-50 ring-1 ring-brand-100"
      ></div>
      <p class="absolute bottom-0 left-1/2 -translate-x-1/2 text-xs font-semibold text-ink-muted">{c.laneCaption}</p>
    </div>

    <div class="lg:col-span-7 lg:pl-8">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="channels-title" class="h2 mt-5 max-w-xl">{c.h2}</h2>
      <p class="lead mt-6 max-w-xl">{c.p}</p>
      <!-- Example customer record: one person, three channels, one history. -->
      <div data-play class="mt-12 max-w-md rounded-3xl border border-line bg-surface p-6 shadow-(--shadow-card) sm:p-7">
        <div class="rise flex items-center justify-between gap-3" style="--i:0">
          <h3 class="text-sm text-ink-muted">{c.listTitle}</h3>
          <span class="rounded-full border border-line px-2.5 py-0.5 text-xs font-semibold text-ink-muted">{r.sample}</span>
        </div>

        <div class="rise mt-7 flex items-center gap-4" style="--i:1">
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-brand-600 font-display text-xl text-white" aria-hidden="true">{r.name.charAt(0)}</span>
          <div class="min-w-0">
            <p class="font-display text-xl leading-tight">{r.name}</p>
            <p class="text-sm text-ink-muted">{r.sub}</p>
          </div>
          <span class="ml-auto rounded-full bg-mint-300 px-3 py-1 text-sm font-semibold">{r.stage}</span>
        </div>

        <ol class="mt-8 ml-1.5 border-l border-line">
          {r.history.map((h, i) => (
            <li class="rise relative pb-6 pl-6" style={`--i:${i + 2}`}>
              <span class="absolute top-1.5 -left-[6.5px] size-3 rounded-full bg-surface ring-2 ring-ink" aria-hidden="true"></span>
              <div class="flex items-baseline justify-between gap-3">
                <span class="font-semibold">{h.ch}</span>
                <span class="text-sm text-ink-muted">{h.day}</span>
              </div>
              <p class="mt-1 text-sm text-ink-muted">{h.note}</p>
            </li>
          ))}
        </ol>

        <div class="rise mt-2 flex items-center justify-between gap-4 rounded-2xl bg-surface-alt px-4 py-3.5" style="--i:5">
          <span class="text-sm text-ink-muted">{r.nextLabel}</span>
          <span class="font-semibold">{r.next}</span>
        </div>
      </div>
    </div>
  </div>
</section>
